# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#   cp .env.example .env.local
#
# .env.local 은 커밋되지 않는다. 실제 키를 .env.example 에 적지 말 것.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > API 에서 확인
#
# PUBLISHABLE_KEY 는 브라우저 번들에 그대로 실려 나가는 공개 키다. 숨길 수 없고
# 숨길 필요도 없다. 데이터를 지키는 것은 이 키가 아니라 RLS 정책이므로,
# 새 테이블을 만들면 반드시 정책을 함께 작성해야 한다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─── 기존 기능 ───────────────────────────────────────────────────────────────
# 지원서 파일 업로드(S3) — components/s3upload
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# 문의 메일 발송(nodemailer) — pages/api/contact.ts
MAIL_USER=
MAIL_PASSWORD=
